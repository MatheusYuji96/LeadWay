# URL base do backend Spring (sem barra final).
# Ex.: http://localhost:8080/api
VITE_API_BASE_URL=

# Quando true, as requisições passam por um adaptador local com fixtures
# derivadas do protótipo (dados de demonstração — NÃO são dados do backend).
# Use apenas em desenvolvimento enquanto o backend não estiver disponível.
VITE_USE_MOCK=true
