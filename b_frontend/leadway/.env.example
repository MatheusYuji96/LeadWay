# URL base do backend Spring (sem barra final).
# Em desenvolvimento local, para usar o proxy do Vite (recomendado), deixe
# VITE_API_BASE_URL vazio (ou remova a variável). O proxy faz /api/* -> http://localhost:8080/*
# Para contornar o proxy e apontar diretamente para o backend, defina:
# VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080

# Quando true, as requisições passam por um adaptador local com fixtures
# derivadas do protótipo (dados de demonstração — NÃO são dados do backend).
# Use apenas em desenvolvimento enquanto o backend não estiver disponível.
VITE_USE_MOCK=false
